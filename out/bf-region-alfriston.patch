@@ -0,0 +1,29 @@
+import type { RippleSpec } from "../hotel-film/ripple/types";
+
+// Black Friday region reel: Just added (Bianca, 10 Nov: "a reel per region to include all cluster hotels, not just one"),
+// 4:5 for the feeds. Every hotel in the region's carousel, cheapest first, each on its exterior then a hero shot, a
+// bar each; the carousel's card (mauve caps place, cream Cormorant name, the offer in a mauve pill) held across the
+// hotel's two shots. Opens on BLACK FRIDAY SALE / Just added, ends on Save up to the region's best offer. Built by
+// scratchpad build.py (clips by still-push.py, cut by cut-picture.py); the region's spotlight track.
+export const bfRegionAlfriston: RippleSpec = {
+  id: "bf-region-alfriston",
+  picture: "campaigns/bf-region-alfriston/picture.mp4",
+  frames: 414,
+  feed: true,
+  label: { eyebrow: "", name: "", from: 0, to: 1 },
+  collage: { to: 118, caps: "Just added", best: "30%", pill: "Book now", tap: 103, tiles: [], hero: true },
+  cards: [
+    { from: 120, to: 296, place: "East Sussex", name: "The Alfriston", offer: "Save 30%" },
+  ],
+  lines: [],
+  deepScrim: true,
+  snap: { beat: 14.775, kicks: [] },
+  endCard: { at: 296, eyebrow: "Black Friday Sale", line: "Make it yours\nwhile it lasts", quick: true },
+  music: {
+    src: "music/kulakovka-luxury-life-618587.mp3",
+    startAt: 346,
+    gain: 0.78,
+    seconds: 145,
+    fadeOut: 45,
+  },
+};
